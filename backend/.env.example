# Copy to backend/.env and fill in. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/iqa
# Used only by the backend test-suite (database is wiped by tests!)
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/iqa_test

# JWT signing secret: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Where uploaded images, thumbnails and previews are stored
STORAGE_DIR=storage

# Model inference device: auto | cpu | cuda
MODEL_DEVICE=auto

# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins (only needed without the Vite proxy)
CORS_ORIGINS=http://localhost:5173
